@model User

@Html.Partial("_Message")

<div class="row pt-5">
	<div class="col-3"></div>
	<div class="col-6 border p-3">
		<h1>Registration</h1>
		<hr />
        <form method="post" action="#">
            <div class="row m-2" bis_skin_checked="1">
                <label asp-for="UserName" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10" bis_skin_checked="1">
                    <input asp-for="UserName" class="form-control-plaintext bg-white text-black">
                </div>
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>
            <div class="row m-2" bis_skin_checked="1">
                <label asp-for="Email" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10" bis_skin_checked="1">
                    <input asp-for="Email" class="form-control-plaintext bg-white text-black">
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div bis_skin_checked="1" class="row m-2">
                <label asp-for="Gender" class="form-label mt-4">Select Gender</label>
                <select class="form-select" asp-for="Gender">
                    <option>Male</option>
                    <option>Female</option>
                    <option>Others</option>
                </select>
            </div>
            <div class="row m-2" bis_skin_checked="1">
                <label asp-for="ContactNumber" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10" bis_skin_checked="1">
                    <input asp-for="ContactNumber" class="form-control-plaintext bg-white text-black">
                </div>
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>
            <div class="row m-2" bis_skin_checked="1">
                <label asp-for="Dob" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10" bis_skin_checked="1">
                    <input asp-for="Dob" class="form-control bg-white text-black">
                </div>
                <span asp-validation-for="Dob" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Role" value="Not Assigned" />
            <div class="row m-2" bis_skin_checked="1">
                <label asp-for="Address" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10" bis_skin_checked="1">
                    <input asp-for="Address" class="form-control-plaintext bg-white text-black">
                </div>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="row m-2" bis_skin_checked="1">
                <label asp-for="Password" class="col-sm-2 col-form-label"></label>
                <div class="col-sm-10" bis_skin_checked="1">
                    <input asp-for="Password" class="form-control-plaintext bg-white text-black">
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Status" value="false" />
            <button type="submit" class="btn btn-primary m-2">Submit</button>
            <a asp-action="Login" asp-controller="Auth" class="btn btn-dark">Back To Login</a>
        </form>
	</div>
	<div class="col-3"></div>
</div>

@section Scripts 
{
	@Html.Partial("_ValidationScriptsPartial")
}
