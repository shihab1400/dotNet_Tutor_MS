@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-wrap">
    <div class="auth-card w-100 mx-auto" style="max-width: 960px">
        <div class="auth-side">
            <div>
                <span class="brand-mark mb-4"><i class="bi bi-mortarboard-fill"></i></span>
                <h2>Welcome back</h2>
                <p>Log in to continue learning, teaching or training.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Track your courses and progress</li>
                    <li><i class="bi bi-check-circle-fill"></i> Download videos, PDFs and slides</li>
                    <li><i class="bi bi-check-circle-fill"></i> Earn certificates as a tutor</li>
                </ul>
            </div>
            <small class="text-secondary">Amar School · Tutor Management</small>
        </div>
        <div class="auth-form">
            <h1>Log in</h1>
            <p class="text-muted mb-4">New here? <a asp-action="Register">Create an account</a></p>
            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="you@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 justify-content-center btn-lg">Log in</button>
            </form>
            <div class="divider-text">demo accounts</div>
            <div class="demo-box">
                <div><strong>Admin:</strong> admin@adn.com / Admin@123</div>
                <div><strong>Trainer:</strong> kamrul.hasan@trainer.com</div>
                <div><strong>Tutor:</strong> rafiq.islam@tutor.com</div>
                <div><strong>Student:</strong> ayan.mahmud@student.com</div>
                <div class="text-muted mt-1">Demo users password: Pass@123</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
