@{
    ViewData["Title"] = "Access denied";
}

<div class="card mx-auto my-5 text-center" style="max-width: 520px">
    <div class="card-body p-5">
        <span class="stat-icon tone-danger mb-3"><i class="bi bi-shield-lock"></i></span>
        <h2>Access denied</h2>
        <p class="text-muted">You don't have permission to view this page.</p>
        <a asp-controller="@(User.Identity?.IsAuthenticated == true ? "Dashboard" : "Home")" asp-action="Index" class="btn btn-primary">Go back home</a>
    </div>
</div>
