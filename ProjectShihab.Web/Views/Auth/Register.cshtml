@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-wrap">
    <div class="auth-card w-100 mx-auto" style="max-width: 1080px">
        <div class="auth-side">
            <div>
                <span class="brand-mark mb-4"><i class="bi bi-mortarboard-fill"></i></span>
                <h2>Join Amar School</h2>
                <p>Students learn from certified tutors. Tutors get trained, certified and start teaching.</p>
                <ul>
                    <li><i class="bi bi-check-circle-fill"></i> Courses from Class 8 to university</li>
                    <li><i class="bi bi-check-circle-fill"></i> Coupon discounts on enrollments</li>
                    <li><i class="bi bi-check-circle-fill"></i> Rate your tutor after every course</li>
                </ul>
            </div>
            <small class="text-secondary">Trainer accounts are created by the admin.</small>
        </div>
        <div class="auth-form">
            <h1>Create your account</h1>
            <p class="text-muted mb-4">Already registered? <a asp-action="Login">Log in</a></p>
            <form asp-action="Register" method="post">
                <label class="form-label">I want to</label>
                <div class="role-picker mb-4">
                    <input type="radio" name="Role" id="roleStudent" value="Student" checked="@(Model.Role != "Tutor")" />
                    <label for="roleStudent"><i class="bi bi-mortarboard"></i><span>Learn<small>Register as a student</small></span></label>
                    <input type="radio" name="Role" id="roleTutor" value="Tutor" checked="@(Model.Role == "Tutor")" />
                    <label for="roleTutor"><i class="bi bi-person-video3"></i><span>Teach<small>Register as a tutor</small></span></label>
                </div>
                <partial name="_PersonFields" model="Model" />
                <button type="submit" class="btn btn-primary btn-lg w-100 justify-content-center mt-4">Create account</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
