@{
    var error = ViewBag.Error as string ?? TempData["Error"]?.ToString();
    var success = ViewBag.Success as string ?? TempData["Success"]?.ToString();
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="flash flash-error alert alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-octagon"></i>
        <div>@error</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (!string.IsNullOrEmpty(success))
{
    <div class="flash flash-success alert alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle"></i>
        <div>@success</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
