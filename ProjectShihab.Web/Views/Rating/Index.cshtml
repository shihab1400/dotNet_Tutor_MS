@model List<Rating>

@Html.Partial("_Message")

<div class="row pt-4">
	<div class="col-6">
		<h2>Ratings</h2>
	</div>
	<hr />
</div>

<div class="row pt-2">
	<div class="col-12">

		<table class="table table-bordered table-hover">
			<tr class="table-info">
				<th>Ref</th>
				<th>User</th>
				<th>CourseType</th>
				<th>CourseId</th>
				<th>Rating</th>
				<th>Feedback</th>
			</tr>

			@if (Model.Count == 0)
			{
				<tr class="table-secondary text-center">
					<td colspan="5">No Data to show.</td>
				</tr>
			}
			else
			{
				foreach (var rating in Model)
				{
					<tr>
						<td>@rating.Id</td>
						<td>@rating.User.UserName</td>
						<td>@rating.CourseType</td>
						<td>@rating.Course.Subject</td>
						<td>@rating.RatingValue</td>
						<td>@rating.Feedback</td>
					</tr>
				}
			}
		</table>

	</div>
</div>