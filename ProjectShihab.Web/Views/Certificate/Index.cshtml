@model List<Certificate>
@{
    ViewData["Title"] = "Certificates";
    var isTutor = User.IsInRole(Roles.Tutor);
}

<div class="page-header">
    <div>
        <h1>@(isTutor ? "My certificates" : "Certificates")</h1>
        <p>@(isTutor ? "Each certificate lets you teach that course." : "Certificates issued to tutors after completing a training.")</p>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card"><partial name="_Empty" model="@(("bi-award", "No certificates yet", isTutor ? "Complete a training to earn your first certificate." : "Nothing issued yet."))" /></div>
}
<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex gap-3 align-items-start">
                        <span class="stat-icon tone-warning"><i class="bi bi-award-fill"></i></span>
                        <div class="flex-grow-1">
                            <h5 class="mb-0">@c.Course?.Subject</h5>
                            <div class="cell-sub">@c.Course?.Group?.Title</div>
                        </div>
                    </div>
                    <hr />
                    <div class="small d-grid gap-1">
                        @if (!isTutor) { <div><span class="text-muted">Tutor:</span> <strong>@c.Tutor?.UserName</strong></div> }
                        <div><span class="text-muted">Trainer:</span> @c.Trainer?.UserName</div>
                        <div><span class="text-muted">Issued:</span> @c.IssuedAt.ToString("dd MMM yyyy")</div>
                        <div class="mono text-muted">@c.CertificateNo</div>
                    </div>
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary mt-3"><i class="bi bi-eye"></i> View certificate</a>
                </div>
            </div>
        </div>
    }
</div>
