@model Certificate
@{
    ViewData["Title"] = "Certificate";
}

<div class="page-header no-print">
    <div>
        <h1>Certificate</h1>
        <p class="mono">@Model.CertificateNo</p>
    </div>
    <div class="page-actions">
        <a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back</a>
        <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
    </div>
</div>

<div class="certificate mx-auto" style="max-width: 860px">
    <div class="text-uppercase fw-bold text-muted small" style="letter-spacing:.2em">Amar School</div>
    <h1 class="display-6 fw-bold mt-2 mb-4">Certificate of Completion</h1>
    <p class="text-muted mb-2">This certificate is proudly presented to</p>
    <div class="name mb-4">@Model.Tutor?.UserName</div>
    <p class="mx-auto" style="max-width:560px">for successfully completing the tutor training programme for
        <strong>@Model.Course?.Subject</strong> (@Model.Course?.Group?.Title) and is qualified to teach this course on Amar School.</p>
    <div class="seal my-4"><i class="bi bi-award-fill"></i></div>
    <div class="row mt-2">
        <div class="col-6">
            <div class="fw-bold text-dark">@Model.Trainer?.UserName</div>
            <div class="border-top mx-auto pt-1 small text-muted" style="max-width:220px">Trainer</div>
        </div>
        <div class="col-6">
            <div class="fw-bold text-dark">@Model.IssuedAt.ToString("dd MMMM yyyy")</div>
            <div class="border-top mx-auto pt-1 small text-muted" style="max-width:220px">Date of issue</div>
        </div>
    </div>
    <div class="small text-muted mt-4 mono">Certificate No. @Model.CertificateNo</div>
</div>
