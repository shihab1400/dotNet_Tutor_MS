@model RatingModel
@{
    ViewData["Title"] = "Rate course";
}

<div class="page-header">
    <div>
        <h1>How was @Model.CourseTitle?</h1>
        <p>Your rating helps other students choose the right tutor.</p>
    </div>
    <div class="page-actions"><a asp-action="Index" class="btn btn-light"><i class="bi bi-arrow-left"></i> Back</a></div>
</div>

<div class="card form-card narrow">
    <div class="card-body p-4">
        <form asp-action="Rate" method="post">
            <input type="hidden" asp-for="CourseEnrollmentId" />
            <input type="hidden" asp-for="CourseTitle" />
            <label class="form-label d-block">Your rating</label>
            <div class="star-input mb-1">
                @for (var i = 5; i >= 1; i--)
                {
                    <input type="radio" name="Rating" id="star@(i)" value="@i" checked="@(Model.Rating == i)" />
                    <label for="star@(i)" title="@i star(s)"><i class="bi bi-star-fill"></i></label>
                }
            </div>
            <div><span asp-validation-for="Rating" class="text-danger small"></span></div>
            <div class="mt-3 mb-4">
                <label asp-for="Feedback" class="form-label">Feedback (optional)</label>
                <textarea asp-for="Feedback" class="form-control" rows="4" placeholder="What did you like? What could be better?"></textarea>
                <span asp-validation-for="Feedback" class="text-danger small"></span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Submit rating</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>
</div>
