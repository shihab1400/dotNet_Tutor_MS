@model List<CourseEnrollment>
@{
    ViewData["Title"] = "My learning";
    var rated = ViewBag.Rated as HashSet<int> ?? new HashSet<int>();
}

<div class="page-header">
    <div>
        <h1>My learning</h1>
        <p>@Model.Count course(s) · @Model.Count(e => e.Status == EnrollmentStatus.Completed) completed</p>
    </div>
    <div class="page-actions"><a asp-controller="OfferedCourse" asp-action="Index" class="btn btn-primary"><i class="bi bi-search"></i> Browse courses</a></div>
</div>

@if (Model.Count == 0)
{
    <div class="card"><partial name="_Empty" model="@(("bi-journal-bookmark", "You haven't enrolled yet", "Find a course with a certified tutor to get started."))" /></div>
}
<div class="row g-3">
    @foreach (var e in Model)
    {
        var done = e.Status == EnrollmentStatus.Completed;
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="tag">@e.OfferedCourse?.Course?.Group?.Title</span>
                        @Ui.Status(e.Status)
                    </div>
                    <h5 class="mb-3">@e.OfferedCourse?.Course?.Subject</h5>
                    @Ui.Person(e.OfferedCourse?.User?.UserName, "Your tutor")
                    <div class="small text-muted mt-3">
                        <div><i class="bi bi-calendar-check"></i> Enrolled @e.EnrolledAt.ToString("dd MMM yyyy")</div>
                        @if (done) { <div><i class="bi bi-flag"></i> Completed @e.CompletedAt?.ToString("dd MMM yyyy")</div> }
                        <div><i class="bi bi-wallet2"></i> Paid @Ui.Money(e.Payment?.FinalAmount ?? 0)</div>
                    </div>
                    <div class="d-flex gap-2 mt-auto pt-3">
                        <a asp-controller="Material" asp-action="Index" asp-route-kind="Course" asp-route-id="@e.OfferedCourseId" class="btn btn-sm btn-light"><i class="bi bi-folder2-open"></i> Materials</a>
                        @if (done && !rated.Contains(e.Id))
                        {
                            <a asp-action="Rate" asp-route-id="@e.Id" class="btn btn-sm btn-soft-warning"><i class="bi bi-star"></i> Rate tutor</a>
                        }
                        else if (done)
                        {
                            <span class="pill pill-warning align-self-center">Rated</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
