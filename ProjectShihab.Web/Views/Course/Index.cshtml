@model List<Course>
@{
    ViewData["Title"] = "Courses";
}

<div class="page-header">
    <div>
        <h1>Courses</h1>
        <p>@Model.Count subject(s) across @Model.Select(c => c.GroupId).Distinct().Count() group(s).</p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="0" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add course</a>
    </div>
</div>

<div class="mb-3" style="max-width:320px">
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input class="form-control" placeholder="Search courses…" data-table-filter="#coursesTable" />
    </div>
</div>

<div class="card table-card">
    @if (Model.Count == 0)
    {
        <partial name="_Empty" model="@(("bi-book", "No courses yet", "Add your first course."))" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="coursesTable">
                <thead><tr><th>Subject</th><th>Group</th><th>Base price</th><th>Created</th><th class="text-end">Action</th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="cell-title">@c.Subject</td>
                            <td><span class="tag">@c.Group?.Title</span></td>
                            <td>@Ui.Money(c.BasePrice)</td>
                            <td class="cell-sub">@c.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i> Edit</a>
                                <form asp-action="Delete" method="post" class="d-inline" data-confirm="Delete course '@c.Subject'?">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm btn-soft-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
