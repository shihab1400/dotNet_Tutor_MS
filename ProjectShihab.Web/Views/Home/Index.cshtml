@model PublicStats
@{
    ViewData["Title"] = "Find certified tutors";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

@section FullWidth {
    <section class="hero">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-7">
                    <span class="eyebrow"><i class="bi bi-patch-check-fill"></i> Every tutor is trained &amp; certified</span>
                    <h1 class="mt-3 mb-3">Learn from tutors who are <span class="grad">certified</span> to teach your subject.</h1>
                    <p class="lead mb-4">From Class 8 Mathematics to university Algorithms, pick a course, pay securely, study with videos, PDFs and slides, and rate your tutor when you finish.</p>
                    <div class="d-flex flex-wrap gap-2">
                        @if (signedIn)
                        {
                            <a class="btn btn-primary btn-lg" asp-controller="Dashboard" asp-action="Index">Go to dashboard <i class="bi bi-arrow-right"></i></a>
                        }
                        else
                        {
                            <a class="btn btn-primary btn-lg" asp-controller="Auth" asp-action="Register">Start learning <i class="bi bi-arrow-right"></i></a>
                            <a class="btn btn-light btn-lg" asp-controller="Auth" asp-action="Register" asp-route-role="Tutor">Become a tutor</a>
                        }
                    </div>
                    <div class="hero-stats">
                        <div><div class="v">@Model.Courses</div><div class="l">Courses</div></div>
                        <div><div class="v">@Model.Tutors</div><div class="l">Certified tutors</div></div>
                        <div><div class="v">@Model.Students</div><div class="l">Active students</div></div>
                        <div><div class="v">@(Model.AverageRating > 0 ? Model.AverageRating.ToString("0.0") : "—")<small class="fs-6 text-warning"> ★</small></div><div class="l">Average rating</div></div>
                    </div>
                </div>
                <div class="col-lg-5 d-none d-lg-block">
                    <div class="hero-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-white fw-semibold">Top rated courses</span>
                            <span class="small text-secondary">Live</span>
                        </div>
                        @foreach (var o in Model.Featured.Take(4))
                        {
                            Model.Ratings.TryGetValue(o.TutorId, out var r);
                            <div class="row-item">
                                <span class="avatar" style="background:rgba(99,102,241,.25);color:#c7d2fe">@Ui.Initials(o.User?.UserName)</span>
                                <div class="flex-grow-1">
                                    <div class="t">@o.Course?.Subject</div>
                                    <div class="s">@o.User?.UserName · @o.Course?.Group?.Title</div>
                                </div>
                                <div class="text-end">
                                    <div class="t">@Ui.Money(o.Price)</div>
                                    <div class="s text-warning">★ @(r.Count > 0 ? r.Average.ToString("0.0") : "new")</div>
                                </div>
                            </div>
                        }
                        @if (!Model.Featured.Any())
                        {
                            <div class="s">Courses will appear here once tutors start teaching.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="features">
        <div class="container">
            <div class="section-title">
                <div class="kicker">Why Amar School</div>
                <h2>One place for students, tutors and trainers</h2>
                <p class="text-muted">A complete learning workflow, from tutor training to student feedback.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3"><div class="card feature"><span class="stat-icon tone-brand"><i class="bi bi-mortarboard"></i></span><h5>For students</h5><p class="text-muted mb-0">Browse courses by class or department and learn at your own pace.</p></div></div>
                <div class="col-md-6 col-lg-3"><div class="card feature"><span class="stat-icon tone-warning"><i class="bi bi-award"></i></span><h5>Certified tutors</h5><p class="text-muted mb-0">Tutors can only teach a subject after a trainer certifies them for it.</p></div></div>
                <div class="col-md-6 col-lg-3"><div class="card feature"><span class="stat-icon tone-danger"><i class="bi bi-collection-play"></i></span><h5>Rich materials</h5><p class="text-muted mb-0">Videos, PDFs and slide decks, available as soon as you enroll.</p></div></div>
                <div class="col-md-6 col-lg-3"><div class="card feature"><span class="stat-icon tone-success"><i class="bi bi-ticket-perforated"></i></span><h5>Coupons &amp; ratings</h5><p class="text-muted mb-0">Save with coupon codes and help others with honest 1 to 5 star reviews.</p></div></div>
            </div>
        </div>
    </section>

    @if (Model.Featured.Any())
    {
        <section class="section pt-0" id="courses">
            <div class="container">
                <div class="section-title">
                    <div class="kicker">Popular right now</div>
                    <h2>Featured courses</h2>
                </div>
                <div class="row g-4">
                    @foreach (var o in Model.Featured)
                    {
                        Model.Ratings.TryGetValue(o.TutorId, out var r);
                        <div class="col-md-6 col-lg-4">
                            <div class="card course-tile">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="tag">@o.Course?.Group?.Title</span>
                                    <span class="small">@Ui.Stars(r.Average) <span class="text-muted">(@r.Count)</span></span>
                                </div>
                                <h5 class="mb-3">@o.Course?.Subject</h5>
                                @Ui.Person(o.User?.UserName, "Certified tutor")
                                <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
                                    <span class="price">@Ui.Money(o.Price)</span>
                                    @if (User.IsInRole(Roles.Student))
                                    {
                                        <a class="btn btn-outline-primary btn-sm" asp-controller="Payment" asp-action="Checkout" asp-route-kind="Course" asp-route-id="@o.Id">Enroll <i class="bi bi-arrow-right"></i></a>
                                    }
                                    else if (!signedIn)
                                    {
                                        <a class="btn btn-outline-primary btn-sm" asp-controller="Auth" asp-action="Login">Enroll <i class="bi bi-arrow-right"></i></a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="section pt-0">
        <div class="container">
            <div class="section-title">
                <div class="kicker">Catalog</div>
                <h2>Subjects for every level</h2>
            </div>
            <div class="row g-4">
                @foreach (var g in Model.Groups)
                {
                    var items = Model.AllCourses.Where(c => c.GroupId == g.Id).ToList();
                    if (!items.Any()) { continue; }
                    <div class="col-md-6 col-lg-4 col-xl">
                        <div class="card card-body h-100 group-block">
                            <h6>@g.Title</h6>
                            @foreach (var c in items)
                            {
                                <div class="d-flex align-items-center gap-2 py-1"><i class="bi bi-check2 text-success"></i> @c.Subject</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="section pt-0" id="how">
        <div class="container">
            <div class="section-title">
                <div class="kicker">How it works</div>
                <h2>Three steps to start learning</h2>
            </div>
            <div class="row g-4 text-center">
                <div class="col-md-4"><div class="step-num">1</div><h5>Create an account</h5><p class="text-muted">Sign up as a student, or as a tutor if you want to teach.</p></div>
                <div class="col-md-4"><div class="step-num">2</div><h5>Pick a course &amp; pay</h5><p class="text-muted">Choose a certified tutor, apply a coupon and complete a quick payment.</p></div>
                <div class="col-md-4"><div class="step-num">3</div><h5>Learn and rate</h5><p class="text-muted">Study with the materials, finish the course and rate your tutor.</p></div>
            </div>
            @if (!signedIn)
            {
                <div class="cta mt-5 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <h2 class="mb-1">Ready to get started?</h2>
                        <div>Join @Model.Students students already learning on Amar School.</div>
                    </div>
                    <a class="btn btn-light btn-lg" asp-controller="Auth" asp-action="Register">Create free account</a>
                </div>
            }
        </div>
    </section>
}
