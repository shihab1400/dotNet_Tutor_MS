@model List<TrainingEnrollment>
@{
    ViewData["Title"] = "My trainings";
}

<div class="page-header">
    <div>
        <h1>My trainings</h1>
        <p>Trainings you have enrolled in. Your certificate is issued after the trainer marks it completed.</p>
    </div>
    <div class="page-actions"><a asp-action="Index" class="btn btn-primary"><i class="bi bi-search"></i> Browse trainings</a></div>
</div>

<div class="card table-card">
    @if (Model.Count == 0)
    {
        <partial name="_Empty" model="@(("bi-easel", "No trainings yet", "Enroll in a training to get certified."))" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Training</th><th>Enrolled</th><th>Paid</th><th>Status</th><th class="text-end">Action</th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td class="cell-title">@e.TrainingOffering?.Course?.Subject</td>
                            <td class="cell-sub">@e.EnrolledAt.ToString("dd MMM yyyy")</td>
                            <td>@Ui.Money(e.Payment?.FinalAmount ?? 0)</td>
                            <td>@Ui.Status(e.Status)</td>
                            <td class="text-end"><a asp-controller="Material" asp-action="Index" asp-route-kind="Training" asp-route-id="@e.TrainingOfferingId" class="btn btn-sm btn-light"><i class="bi bi-folder2-open"></i> Materials</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
