@model List<TrainingEnrollment>
@{
    ViewData["Title"] = "Enrolled tutors";
    var issued = ViewBag.Issued as HashSet<int> ?? new HashSet<int>();
}

<div class="page-header">
    <div>
        <h1>Enrolled tutors</h1>
        <p>Mark a training as completed, then issue the tutor's certificate.</p>
    </div>
</div>

<div class="card table-card">
    @if (Model.Count == 0)
    {
        <partial name="_Empty" model="@(("bi-people", "No tutors enrolled yet", "Tutors appear here after they pay for one of your trainings."))" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Tutor</th><th>Training</th><th>Enrolled</th><th>Status</th><th class="text-end">Action</th></tr></thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@Ui.Person(e.Tutor?.UserName, e.Tutor?.Email)</td>
                            <td class="cell-title">@e.TrainingOffering?.Course?.Subject</td>
                            <td class="cell-sub">@e.EnrolledAt.ToString("dd MMM yyyy")</td>
                            <td>@Ui.Status(e.Status)</td>
                            <td class="text-end">
                                @if (e.Status == EnrollmentStatus.Enrolled)
                                {
                                    <form asp-action="Complete" method="post" class="d-inline" data-confirm="Mark training as completed for @e.Tutor?.UserName?">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-sm btn-soft-success"><i class="bi bi-check2-circle"></i> Mark completed</button>
                                    </form>
                                }
                                else if (!issued.Contains(e.Id))
                                {
                                    <form asp-action="Certify" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@e.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-award"></i> Issue certificate</button>
                                    </form>
                                }
                                else
                                {
                                    @Ui.Pill("Certified", "warning")
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
