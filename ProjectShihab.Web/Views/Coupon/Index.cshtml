@model List<Coupon>
@{
    ViewData["Title"] = "Coupons";
}

<div class="page-header">
    <div>
        <h1>Coupons</h1>
        <p>Discount codes students and tutors can apply at checkout.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="0" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New coupon</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card"><partial name="_Empty" model="@(("bi-ticket-perforated", "No coupons yet", "Create a percentage or fixed-amount coupon."))" /></div>
}
<div class="row g-3">
    @foreach (var c in Model)
    {
        var status = !c.IsActive ? ("Inactive", "muted") : c.ExpiryDate.Date < DateTime.Today ? ("Expired", "danger") : c.UsedCount >= c.MaxUses ? ("Used up", "warning") : ("Active", "success");
        var pct = c.MaxUses == 0 ? 0 : Math.Min(100, c.UsedCount * 100 / c.MaxUses);
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <div class="mono fs-5 fw-bold text-dark">@c.Code</div>
                            <div class="cell-sub">@(c.Type == CouponTypes.Percentage ? "Percentage discount" : "Fixed amount off")</div>
                        </div>
                        @Ui.Pill(status.Item1, status.Item2)
                    </div>
                    <div class="display-6 fw-bold text-dark mb-3">@(c.Type == CouponTypes.Percentage ? $"{c.Value:0.##}%" : Ui.Money(c.Value)) <span class="fs-6 text-muted fw-normal">off</span></div>
                    <div class="d-flex justify-content-between small text-muted mb-1"><span>Used @c.UsedCount of @c.MaxUses</span><span>Expires @c.ExpiryDate.ToString("dd MMM yyyy")</span></div>
                    <div class="progress mb-3" style="height:6px"><div class="progress-bar" style="width:@pct%;background:var(--brand)"></div></div>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light"><i class="bi bi-pencil"></i> Edit</a>
                </div>
            </div>
        </div>
    }
</div>
