@model List<Payment>
@{
    ViewData["Title"] = "Payments";
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div class="page-header">
    <div>
        <h1>@(isAdmin ? "Payments" : "Payment history")</h1>
        <p>@Model.Count transaction(s) · @Ui.Money(Model.Sum(p => p.FinalAmount)) paid · @Ui.Money(Model.Sum(p => p.DiscountAmount)) saved with coupons</p>
    </div>
</div>

<div class="card table-card">
    @if (Model.Count == 0)
    {
        <partial name="_Empty" model="@(("bi-receipt", "No payments yet", "Receipts appear here after you enroll."))" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>Transaction</th>@if (isAdmin) { <th>User</th> }<th>For</th><th class="text-end">Price</th><th class="text-end">Discount</th><th class="text-end">Paid</th><th>Coupon</th><th>Date</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="mono">@p.TransactionRef</td>
                            @if (isAdmin) { <td>@Ui.Person(p.User?.UserName, p.User?.Role)</td> }
                            <td>@Ui.Pill(p.Kind, p.Kind == PaymentKinds.Training ? "warning" : "brand") <span class="cell-sub">#@p.TargetId</span></td>
                            <td class="text-end">@Ui.Money(p.OriginalAmount)</td>
                            <td class="text-end @(p.DiscountAmount > 0 ? "text-success" : "text-muted")">@(p.DiscountAmount > 0 ? "− " + Ui.Money(p.DiscountAmount) : "—")</td>
                            <td class="text-end cell-title">@Ui.Money(p.FinalAmount)</td>
                            <td>@if (p.Coupon != null) { <span class="tag mono">@p.Coupon.Code</span> }</td>
                            <td class="cell-sub text-nowrap">@p.PaidAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
